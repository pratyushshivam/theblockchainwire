{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theblockchainwire",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "theblockchainwire.com", "custom_domain": true },
    { "pattern": "www.theblockchainwire.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
